# Copy this file to .env and adjust values for your local setup.
APP_ENV=development

# Local ChromaDB persistence directory.
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=phonetic_rules

# Hugging Face model used by the audio scorer.
ASR_MODEL_NAME=openai/whisper-small

# Audio preprocessing requirements.
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Minimum score used to classify a word as requiring pronunciation feedback.
PRONUNCIATION_THRESHOLD=0.70
